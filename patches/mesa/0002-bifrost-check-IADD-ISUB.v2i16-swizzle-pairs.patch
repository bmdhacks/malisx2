From b010d7fe3747a2ba9096873269962840d208b017 Mon Sep 17 00:00:00 2001
From: Joey <44435198+JoeysRetroHandhelds@users.noreply.github.com>
Date: Tue, 3 Nov 2026 05:48:54 +0000
Subject: [PATCH 2/2] bifrost: check +IADD/+ISUB.v2i16 swizzle pairs

+IADD/+ISUB.v2{s,u}16 encode a swapped first source (H10) only next to a
second source of H01 or H10. The per-source swizzle tables cannot say so,
and copy propagation could combine two individually valid swizzles into
one the ADD unit cannot pack (bi_pack_add_iadd_v2s16: no matching state).
Check the pair in copy propagation and lower the first source's swizzle
in bi_lower_swizzle when the pair is not encodable.
---
 .../compiler/bifrost/bi_lower_swizzle.c       | 66 +++++++++++++++++++
 .../compiler/bifrost/bi_opt_copy_prop.c       |  2 +-
 src/panfrost/compiler/bifrost/compiler.h      |  2 +
 3 files changed, 69 insertions(+), 1 deletion(-)

diff --git a/src/panfrost/compiler/bifrost/bi_lower_swizzle.c b/src/panfrost/compiler/bifrost/bi_lower_swizzle.c
index d7e9280..35e3e71 100644
--- a/src/panfrost/compiler/bifrost/bi_lower_swizzle.c
+++ b/src/panfrost/compiler/bifrost/bi_lower_swizzle.c
@@ -104,6 +104,67 @@ bi_op_supports_swizzle(enum bi_opcode op, unsigned src,
    return supported_swizzles & BITFIELD_BIT(swizzle);
 }
 
+/* +IADD/+ISUB.v2{s,u}16 (Bifrost, ADD unit only) encode a swapped first
+ * source (H10) only next to a second source of H01 or H10; the per-source
+ * tables (bi_op_swizzles) cannot say so. */
+static bool
+bi_v2i16_add_pair_ok(enum bi_opcode op, enum bi_swizzle swz0,
+                     enum bi_swizzle swz1, unsigned arch)
+{
+   if (arch >= 9)
+      return true;
+
+   switch (op) {
+   case BI_OPCODE_IADD_V2S16:
+   case BI_OPCODE_IADD_V2U16:
+   case BI_OPCODE_ISUB_V2S16:
+   case BI_OPCODE_ISUB_V2U16:
+      return swz0 != BI_SWIZZLE_H10 ||
+             swz1 == BI_SWIZZLE_H01 || swz1 == BI_SWIZZLE_H10;
+   default:
+      return true;
+   }
+}
+
+/* bi_op_supports_swizzle for source src of ins taking swizzle, with the
+ * instruction's other sources as they are. */
+bool
+bi_instr_supports_swizzle(const bi_instr *ins, unsigned src,
+                          enum bi_swizzle swizzle, unsigned arch)
+{
+   if (!bi_op_supports_swizzle(ins->op, src, swizzle, arch))
+      return false;
+   if (src > 1)
+      return true;
+
+   enum bi_swizzle swz0 = src == 0 ? swizzle : ins->src[0].swizzle;
+   enum bi_swizzle swz1 = src == 1 ? swizzle : ins->src[1].swizzle;
+   return bi_v2i16_add_pair_ok(ins->op, swz0, swz1, arch);
+}
+
+/* Moves source src's swizzle into a SWZ before ins. */
+static void
+lower_swizzle_away(bi_context *ctx, bi_instr *ins, unsigned src)
+{
+   if (ins->src[src].type == BI_INDEX_CONSTANT) {
+      ins->src[src].value =
+         bi_apply_swizzle(ins->src[src].value, ins->src[src].swizzle);
+      ins->src[src].swizzle = BI_SWIZZLE_H01;
+      return;
+   }
+
+   bi_builder b = bi_init_builder(ctx, bi_before_instr(ins));
+
+   bi_index orig = ins->src[src];
+   bi_index stripped = bi_replace_index(bi_null(), orig);
+   stripped.swizzle = ins->src[src].swizzle;
+
+   bi_index swz = bi_swz_v4i8(&b, stripped);
+
+   bi_replace_src(ins, src, swz);
+   ins->src[src].swizzle = BI_SWIZZLE_H01;
+}
+
 static void
 lower_swizzle(bi_context *ctx, bi_instr *ins, unsigned src)
 {
@@ -239,6 +300,11 @@ bi_lower_swizzle(bi_context *ctx)
 
          lower_swizzle(ctx, ins, s);
       }
+
+      if (ins->nr_srcs >= 2 &&
+          !bi_v2i16_add_pair_ok(ins->op, ins->src[0].swizzle,
+                                ins->src[1].swizzle, ctx->arch))
+         lower_swizzle_away(ctx, ins, 0);
    }
 
    /* Now that we've lowered swizzles, clean up the mess */
diff --git a/src/panfrost/compiler/bifrost/bi_opt_copy_prop.c b/src/panfrost/compiler/bifrost/bi_opt_copy_prop.c
index c63e996..9dc6a1a 100644
--- a/src/panfrost/compiler/bifrost/bi_opt_copy_prop.c
+++ b/src/panfrost/compiler/bifrost/bi_opt_copy_prop.c
@@ -301,7 +301,7 @@ byte_chase_instr_srcs(bi_context *ctx, bi_instr *I, struct hash_table *ht)
       if (bi_is_null(repl))
          continue;
 
-      if (!bi_op_supports_swizzle(I->op, s, repl.swizzle, ctx->arch))
+      if (!bi_instr_supports_swizzle(I, s, repl.swizzle, ctx->arch))
          continue;
 
       if (bi_is_staging_src(I, s) && repl.type != BI_INDEX_NORMAL)
diff --git a/src/panfrost/compiler/bifrost/compiler.h b/src/panfrost/compiler/bifrost/compiler.h
index 0c82ece..6c1d84a 100644
--- a/src/panfrost/compiler/bifrost/compiler.h
+++ b/src/panfrost/compiler/bifrost/compiler.h
@@ -1640,6 +1640,8 @@ bool bi_can_replace_with_csel(bi_instr *I);
 void bi_calc_dominance(bi_context *ctx);
 bool bi_block_dominates(bi_block *parent, bi_block *child);
 
+bool bi_instr_supports_swizzle(const bi_instr *ins, unsigned src,
+                               enum bi_swizzle swizzle, unsigned arch);
 void bi_print_instr(const bi_instr *I, FILE *fp);
 void bi_print_instr_impl(const bi_instr *I, FILE *fp);
 void bi_print_slots(bi_registers *regs, FILE *fp);
-- 
